DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-strong-secret
SESSION_SECRET=replace-with-a-strong-session-secret

CRON_SECRET=replace-with-a-strong-cron-secret

# Maximum template/object path segments; bounded internally to 8..256.
TEMPLATE_MAX_PATH_SEGMENTS=64

# Workflow step limits (API Watcher chains, Form Builder workflows).
# Per-watcher Performance settings are clamped to these ceilings.
WORKFLOW_MAX_CHAIN_STEPS=25
WORKFLOW_BROWSER_MAX_CONCURRENCY=5
WORKFLOW_BROWSER_MAX_TIMEOUT_MS=120000
WORKFLOW_BROWSER_DEFAULT_TIMEOUT_MS=15000
WORKFLOW_BROWSER_HEADLESS=true
WORKFLOW_MESSAGE_DLQ_MAX_WINDOW_SECONDS=600
WORKFLOW_MESSAGE_DLQ_PEEK_COUNT=100

# ---------------------------------------------------------------------------
# Security Phase 1 (all optional; defaults are backward compatible)
# ---------------------------------------------------------------------------
# First administrator on an EMPTY database (otherwise a random temporary
# password is printed once to the server log). Must be changed at first login.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@local.invalid

# Who may embed External View pages (BIC/BECS). Empty = legacy "*" (warned).
# Example: EMBED_ALLOWED_ORIGINS=https://bic.example.com,https://becs.example.com
# A full page address is accepted and reduced to its site (scheme + host + port);
# every path under that site is then allowed.
EMBED_ALLOWED_ORIGINS=
# true = Maximo External View pages (/, /work-order, /work-order-update) only
# open when embedded (by EMBED_ALLOWED_ORIGINS) or for a signed-in user.
# Opening the link directly in a browser shows a notice instead of the page.
EXTERNAL_PAGES_EMBED_ONLY=false
# Page paths that may be embedded (defaults: /, /work-order, /work-order-update, /forms/, /analytics/ and legacy .html)
EMBEDDABLE_PATHS=
# off | report-only | enforce — baseline Content-Security-Policy
SECURITY_CSP_MODE=off
SECURITY_HSTS_MAX_AGE=15552000

# Maximo External View API authentication rollout: off | warn | enforce
EXTERNAL_API_AUTH_MODE=warn
EXTERNAL_KEY_CACHE_SECONDS=60
EXTERNAL_API_WARN_LOG_INTERVAL_SECONDS=300

# Rate limits "requests/seconds" per client IP ("off" disables a rule)
RATE_LIMIT_STORE=memory
RATE_LIMIT_AUTH=20/60
RATE_LIMIT_PUBLIC=120/60
RATE_LIMIT_EXTERNAL=600/60
RATE_LIMIT_ADMIN=1200/60
# Reverse proxies in front of the app (Vercel / one proxy = 1, none = 0)
TRUST_PROXY_HOPS=1

# Sign-in protection & password policy
SESSION_MAX_AGE_HOURS=8
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_MIN_CHARACTER_CLASSES=3

# Outbound network policy (REST + Browser RPA)
WORKFLOW_PRIVATE_HOST_ALLOWLIST=
WORKFLOW_RPA_NETWORK_POLICY=public-only
WORKFLOW_RPA_UPLOAD_ROOT=
NETWORK_DNS_CACHE_SECONDS=60

# Database TLS: auto | disable | require | verify-full (+ DATABASE_SSL_CA)
DATABASE_SSL_MODE=auto
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=10000

# Portable server
PORT=3001
APP_DIST_DIR=dist
APP_SHELL_CACHE_SECONDS=300
API_WATCHER_SCHEDULER=on
API_WATCHER_SCHEDULER_INTERVAL_SECONDS=60
API_WATCHER_SCHEDULER_BATCH_SIZE=20

# ---------------------------------------------------------------------------
# Analytics Time Series & viewer toolbar (all optional; safe defaults)
# ---------------------------------------------------------------------------
# Points returned per series after downsampling (ceiling / default)
ANALYTICS_MAX_POINTS_PER_SERIES=5000
ANALYTICS_DEFAULT_POINTS_PER_SERIES=2000
# Measures per time-series definition
ANALYTICS_MAX_MEASURES=24
# Viewer toolbar filters per definition, dropdown options per filter, value length
ANALYTICS_MAX_RUNTIME_FILTERS=10
ANALYTICS_MAX_FILTER_OPTIONS=100
ANALYTICS_MAX_RUNTIME_VALUE_LENGTH=200
# Widest custom time range a viewer may request (days)
ANALYTICS_MAX_RANGE_DAYS=366
# Largest JSON request body a POST data source may define (bytes)
ANALYTICS_MAX_REQUEST_BODY_BYTES=65536
# Source API timeout (ms): used when a definition leaves Timeout blank / ceiling
# for any definition (1000-120000). Keep the hosting platform's request timeout
# above the ceiling.
ANALYTICS_DEFAULT_SOURCE_TIMEOUT_MS=15000
ANALYTICS_MAX_SOURCE_TIMEOUT_MS=60000
# Per-measure toolbars: source calls one view may make when the time range is
# sent to the source (same range = one shared call) / calls run in parallel
ANALYTICS_MAX_SOURCE_CALLS_PER_RUN=3
ANALYTICS_SOURCE_CONCURRENCY=2
# Reuse identical successful source responses for N seconds (0 = off), per
# server process. Keyed by organization + full request; Refresh bypasses it.
ANALYTICS_SOURCE_CACHE_TTL_SECONDS=0
ANALYTICS_SOURCE_CACHE_MAX_ENTRIES=100
ANALYTICS_SOURCE_CACHE_MAX_ENTRY_BYTES=2000000

# ---------------------------------------------------------------------------
# Analytics Pages (dropdown of items → one of several analytics)
# ---------------------------------------------------------------------------
# Items one dropdown may hold (static or from the item API; extra are cut off)
ANALYTICS_PAGE_MAX_ITEMS=500
# Routing rules per page / host-link parameters per page
ANALYTICS_PAGE_MAX_RULES=50
ANALYTICS_PAGE_MAX_PARAMETERS=20
# Reuse an item API response for N seconds (0 = off), per server process.
# Keyed by organization + full rendered request; Retry/fresh bypasses it.
ANALYTICS_PAGE_ITEMS_CACHE_TTL_SECONDS=60
ANALYTICS_PAGE_ITEMS_CACHE_MAX_ENTRIES=200
